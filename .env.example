# Backend API base. Local: http://localhost:3000/api/v1  |  Railway: https://eduflow-backend-production-dae8.up.railway.app/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# Google Identity Services client ID. This one genuinely is public (NEXT_PUBLIC_) — Google's own
# GSI script reads it in the browser. Leave blank until a real Google Cloud OAuth Client ID is
# provisioned; the login page's Google buttons simply don't render while this is unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
